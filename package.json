{
  "name": "about.byhamza.xyz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:web": "npm run dev -w apps/web",
    "dev:studio": "npm run dev -w apps/studio",
    "build": "npm run build -w apps/web && npm run build -w apps/studio",
    "build:worker": "npm run build:worker -w apps/web && npm run build:worker -w apps/studio",
    "preview": "npm run preview -w apps/web",
    "preview:studio": "npm run preview -w apps/studio",
    "deploy": "npm run deploy -w apps/studio && npm run deploy -w apps/web",
    "lint": "eslint",
    "generate:types": "npm run generate:types -w apps/studio",
    "generate:importmap": "npm run generate:importmap -w apps/studio",
    "seed": "npm run seed -w apps/studio",
    "postinstall": "node scripts/postinstall.js"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "typescript": "^5"
  }
}
