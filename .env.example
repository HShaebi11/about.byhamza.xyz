# Copy to `.env` and fill in the values.

# A long, random string used by Payload to sign sessions/tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Postgres connection string (e.g. Neon). Include `?sslmode=require` for Neon.
DATABASE_URL=

# The public URL of the deployed site.
NEXT_PUBLIC_SERVER_URL=https://about.byhamza.xyz

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# Which storage backend to use: `local`, `vercel-blob`, or `r2`.
# If unset, it is auto-detected from the credentials below.
STORAGE_ADAPTER=

# Vercel Blob (auto-injected by Vercel when using Blob storage)
BLOB_READ_WRITE_TOKEN=

# Cloudflare R2 (S3-compatible)
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# Public base URL for reading files, e.g. https://media.byhamza.xyz
R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Draft preview
# ---------------------------------------------------------------------------
# Shared secret for the `/api/preview` route. The Payload admin "Preview"
# button links to `/api/preview?secret=<this>&slug=/project/<slug>`.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PREVIEW_SECRET=

# ---------------------------------------------------------------------------
# Seed (optional)
# ---------------------------------------------------------------------------
# Admin credentials created by `npm run seed`. If unset, a random password is
# generated and printed when the seed runs.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
