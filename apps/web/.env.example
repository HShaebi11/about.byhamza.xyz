# Studio CMS API — where the web app fetches content.
# Production default is baked into wrangler.jsonc vars; override locally:
CMS_API_URL=http://localhost:3001/api

# PostHog Analytics & Telemetry
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
